@model EvaBecario2026_Cabrera.Models.ReclamosModel

@{
    ViewBag.Title = "Nuevo Reclamo";
}

<div class="container py-4" style="max-width: 760px;">
    @* Encabezado *@
    <div class="d-flex justify-content-between align-items-baseline pb-3 mb-4 border-bottom">
        <div>
            <h3 class="fw-semibold text-dark mb-1">Nuevo Reclamo</h3>
            <p class="text-muted small mb-0">Ingrese la información requerida del incidente</p>
        </div>
    </div>

    <div class="border rounded-1 bg-white p-4">
        @using (Html.BeginForm("Crear", "Reclamos", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3 p-2 bg-light border border-danger border-opacity-25 rounded-1" })

            <div class="mb-4">
                <span class="text-uppercase text-muted fw-bold font-monospace" style="font-size: 0.7rem; letter-spacing: 0.05em;">Consumidor</span>
                <hr class="mt-1 mb-3 text-muted opacity-25" />

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        @Html.LabelFor(m => m.NombresConsumidor, new { @class = "form-label small text-secondary mb-1" })
                        @Html.TextBoxFor(m => m.NombresConsumidor, new { @class = "form-control form-control-sm rounded-1 shadow-none" })
                        @Html.ValidationMessageFor(m => m.NombresConsumidor, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-sm-6">
                        @Html.LabelFor(m => m.ApellidosConsumidor, new { @class = "form-label small text-secondary mb-1" })
                        @Html.TextBoxFor(m => m.ApellidosConsumidor, new { @class = "form-control form-control-sm rounded-1 shadow-none" })
                        @Html.ValidationMessageFor(m => m.ApellidosConsumidor, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        @Html.LabelFor(m => m.DUI, new { @class = "form-label small text-secondary mb-1" })
                        @Html.TextBoxFor(m => m.DUI, new { @class = "form-control form-control-sm font-monospace rounded-1 shadow-none", placeholder = "00000000-0" })
                        @Html.ValidationMessageFor(m => m.DUI, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-sm-6">
                        @Html.LabelFor(m => m.Telefono, new { @class = "form-label small text-secondary mb-1" })
                        @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control form-control-sm rounded-1 shadow-none" })
                        @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger small" })
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <span class="text-uppercase text-muted fw-bold font-monospace" style="font-size: 0.7rem; letter-spacing: 0.05em;">Proveedor</span>
                <hr class="mt-1 mb-3 text-muted opacity-25" />

                <div class="row g-3">
                    <div class="col-sm-6">
                        @Html.LabelFor(m => m.NombreProveedor, new { @class = "form-label small text-secondary mb-1" })
                        @Html.TextBoxFor(m => m.NombreProveedor, new { @class = "form-control form-control-sm rounded-1 shadow-none" })
                        @Html.ValidationMessageFor(m => m.NombreProveedor, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-sm-6">
                        @Html.LabelFor(m => m.DireccionProveedor, new { @class = "form-label small text-secondary mb-1" })
                        @Html.TextBoxFor(m => m.DireccionProveedor, new { @class = "form-control form-control-sm rounded-1 shadow-none" })
                        @Html.ValidationMessageFor(m => m.DireccionProveedor, "", new { @class = "text-danger small" })
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <span class="text-uppercase text-muted fw-bold font-monospace" style="font-size: 0.7rem; letter-spacing: 0.05em;">Detalle del reclamo</span>
                <hr class="mt-1 mb-3 text-muted opacity-25" />

                <div class="mb-3">
                    @Html.LabelFor(m => m.DetalleReclamo, new { @class = "form-label small text-secondary mb-1" })
                    @Html.TextAreaFor(m => m.DetalleReclamo, new { @class = "form-control form-control-sm rounded-1 shadow-none", rows = "3" })
                    @Html.ValidationMessageFor(m => m.DetalleReclamo, "", new { @class = "text-danger small" })
                </div>

                <div class="col-sm-5">
                    @Html.LabelFor(m => m.MontoReclamado, new { @class = "form-label small text-secondary mb-1" })
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-muted border-end-0 rounded-start-1">$</span>
                        @Html.TextBoxFor(m => m.MontoReclamado, new { @class = "form-control form-control-sm rounded-end-1 shadow-none font-monospace", type = "number", step = "0.01"})
                    </div>
                    @Html.ValidationMessageFor(m => m.MontoReclamado, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                @Html.ActionLink("Cancelar", "Index", "Reclamos", null, new { @class = "btn btn-outline-secondary btn-sm px-3 rounded-1 shadow-none" })
                <button type="submit" class="btn btn-dark btn-sm px-4 rounded-1 shadow-none">Guardar</button>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}